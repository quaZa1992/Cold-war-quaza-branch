+#########################################################################################
+# Imperia: Uranium as a resource
+#
+# Supply chain (real world, 2000):
+#   uranium mines (state resource "uranium" from history = mines operating in 2000,
+#   plus the "Uranium Mine" building on known deposits; 1 unit = 100 t U/year)
+#   -> world market / trade
+#   -> enrichment facilities (MD building, consume 25 units each via country_resource_cost_uranium)
+#   -> reactor-grade fuel (MD energy system: total_nuclear_reactor_fuel_production)
+#   -> nuclear reactors (MD energy system)
+# Deposits: OECD-NEA/IAEA Red Book "Uranium 2020", identified resources < USD 260/kgU
+# (USA: EIA estimate, the Red Book only lists part of the US resources).
+# Mine output follows MD building balancing (microchip plant: 6 per level), scaled by deposit size:
+#   deposit >= 400k t: 12 per level | >= 150k t: 9 | >= 50k t: 6 | >= 15k t: 4 | smaller: 3
+#   allowed levels:    >= 50k t: 3 | >= 10k t: 2 | smaller: 1
+# What was already mined in 2000 is in the state history; mines add to it.
+# Uranium is also needed for nuclear warheads (nuclear missiles), naval reactors and
+# nuclear torpedoes (equipment/module resource costs) and for nuclear special projects.
+#
+# In 2000 only ~55 % of the reactor demand came from mines; the rest came from
+# "secondary supply" (down-blended weapons HEU, inventories, re-enriched tails).
+# Therefore an enrichment facility without any uranium still works at 45 %.
+#########################################################################################
+
+@imp_uranium_per_enrichment_facility = 25
+
+# Country scope, called from energy_calc_generation after the enrichment output was calculated
+imp_uranium_enrichment_supply = {
+	set_variable = {
+		uranium_enrichment_need = {
+			value = total_enrichment_facilities
+			multiply = @imp_uranium_per_enrichment_facility
+		}
+	}
+	# resource@uranium is the net balance after the facilities took their share:
+	# a negative value is the missing uranium
+	set_variable = {
+		uranium_supply_ratio = {
+			value = uranium_enrichment_need
+			add = resource@uranium
+			divide = { value = uranium_enrichment_need clamp = { min = 0.01 max = 999999 } }
+			clamp = { min = 0 max = 1 }
+		}
+	}
+	set_variable = {
+		uranium_enrichment_output_factor = {
+			value = uranium_supply_ratio
+			multiply = 0.55
+			add = 0.45
+		}
+	}
+	multiply_variable = { total_nuclear_reactor_fuel_production = uranium_enrichment_output_factor }
+	round_variable = total_nuclear_reactor_fuel_production
+}
