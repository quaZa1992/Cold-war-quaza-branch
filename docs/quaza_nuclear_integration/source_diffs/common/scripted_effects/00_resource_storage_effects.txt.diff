+# Imperia: uranium can be stored like the other resources (resource@uranium is the net balance after enrichment facilities)
+resource_storage_uranium_calc_effect = {
+	set_temp_variable = { old_resource_draw_value = uranium_from_storage }
+	set_temp_variable = {
+		resource_base_value = {
+			value = resource@uranium
+			subtract = uranium_from_storage
+		}
+	}
+	set_variable = { uranium_storage_display = resource_base_value }
+
+	if = {
+		#Only draw resources if we have a deficit, want to draw, and have the resources to draw
+		limit = {
+			check_expr = { value = resource_base_value less_than = 0 }
+			check_expr = { value = uranium_in_storage greater_than = 0 }
+			OR = {
+				is_ai = yes
+				has_country_flag = uranium_storage_draw
+			}
+		}
+		subtract_from_variable = {
+			var = uranium_in_storage
+			value = {
+				value = resource_base_value
+				multiply = -1
+				clamp = { min = -1000 max = max_storage }
+			}
+		}
+
+		if = { limit = { check_expr = { value = uranium_in_storage less_than = 0 } }
+			#We overdrew and don't have enough in storage anymore, so reduce the amount taken and empty the store
+			add_to_temp_variable = { resource_base_value = uranium_in_storage }
+			set_variable = { uranium_in_storage = 0 }
+		}
+		set_variable = {
+			uranium_from_storage = {
+				value = resource_base_value
+				multiply = -1
+			}
+		}
+		set_variable = { uranium_storage_display = resource_base_value }
+		set_temp_variable = { resource_base_value = 0 }
+	}
+	else_if = {
+		#check if we ran out. if we ran out, stop pulling
+		limit = { check_expr = { value = uranium_in_storage equals = 0 } }
+		set_variable = { uranium_from_storage = 0 }
+		set_variable = { uranium_storage_display = 0 }
+	}
+	if = {
+		limit = {
+			check_expr = { value = resource_base_value greater_than = 0 }
+			check_expr = { value = uranium_in_storage less_than = max_storage }
+		}
+		add_to_variable = {
+			var = uranium_in_storage
+			value = {
+				value = resource_base_value
+				clamp = { min = -1000 max = max_storage }
+			}
+		}
+		set_variable = { uranium_from_storage = 0 }
+		set_variable = { uranium_storage_display = resource_base_value }
+	}
+	else_if = {
+		limit = { 
+			check_expr = { value = resource_base_value less_than = 1 }
+			NOT = { has_country_flag = uranium_storage_draw }
+		}
+		set_variable = { uranium_storage_display = 0 }
+	}
+}
