+
+# State scope. No parameterized scripted triggers: the engine requires plain yes/no calls.
+imp_uranium_investment_one_level_available = {
+	has_dynamic_modifier = { modifier = imp_uranium_deposit }
+	has_variable = imp_uranium_per_level
+	is_demilitarized_zone = no
+	check_variable = { imp_uranium_mine_slots > building_level@uranium_mine }
+	free_building_slots = { building = uranium_mine size > 0 }
+}
+
+imp_uranium_investment_two_levels_available = {
+	imp_uranium_investment_one_level_available = yes
+	check_variable = { imp_uranium_mine_slots > 1 }
+	free_building_slots = { building = uranium_mine size > 1 }
+	if = { limit = { check_variable = { imp_uranium_mine_slots < 3 } }
+		uranium_mine < 1
+	}
+	else = { uranium_mine < 2 }
+}
+
+imp_uranium_investment_three_levels_available = {
+	imp_uranium_investment_one_level_available = yes
+	check_variable = { imp_uranium_mine_slots > 2 }
+	uranium_mine < 1
+	free_building_slots = { building = uranium_mine size > 2 }
+}
+
+investments_building_uranium_mine_available = {
+	if = { limit = { check_variable = { ROOT.project_build_amount^-1 = 1 } }
