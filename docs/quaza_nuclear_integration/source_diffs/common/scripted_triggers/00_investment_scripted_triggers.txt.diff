+	}
+	else_if = { limit = { check_variable = { ROOT.project_build_amount^-1 = 2 } }
+		imp_uranium_investment_two_levels_available = yes
+	}
+	else_if = { limit = { check_variable = { ROOT.project_build_amount^-1 = 3 } }
+		imp_uranium_investment_three_levels_available = yes
+	}
+	else = { always = no }
+}
