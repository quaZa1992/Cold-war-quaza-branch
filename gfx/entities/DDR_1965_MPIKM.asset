# IMPERIA CW — Cold War: East German unit models and entity definitions.
# NVA MPi-KM with the existing MD AKM event states and sound.
# Hand and back variants match the MD infantry attachment conventions.
# This rigid weapon follows its attachment bone; its states trigger effects only.
entity = {
	name = "DDR_1965_MPIKM_right_entity"
	pdxmesh = "DDR_1965_MPIKM_mesh"

	get_state_from_parent = yes
	default_state = "idle"
	state = { name = "idle" }
	state = { name = "move"	}

	state = { name = "attack"
		event = { time = 0 node="muzzle" particle = "mg_muzzle_particle"  keep_particle = yes   light = "mg_muzzle_flash" sound = { soundeffect = AKM_rifle } }
		event = { time = 0 node="muzzle"   light = "mg_muzzle_flash" }
		event = { time = 0 node="cartridge" particle = "mg_cartridge_particle"  keep_particle = yes }
	}

	state = { name = "defend"
		event = { time = 0 node="muzzle" particle = "mg_muzzle_particle"  keep_particle = yes   light = "mg_muzzle_flash" sound = { soundeffect = AKM_rifle } }
		event = { time = 0 node="muzzle"   light = "mg_muzzle_flash" }
		event = { time = 0 node="cartridge" particle = "mg_cartridge_particle"  keep_particle = yes }
	}

	state = {
		name = "support_attack"
		event = { time = 0 node="muzzle" particle = "mg_muzzle_particle"  keep_particle = yes light = "mg_muzzle_flash" sound = { soundeffect = AKM_rifle } }
		event = { time = 0 node="muzzle" light = "mg_muzzle_flash" }
		event = { time = 0 node="cartridge" particle = "mg_cartridge_particle"  keep_particle = yes }
	}
}

entity = {
	name = "DDR_1965_MPIKM_left_entity"
	pdxmesh = "DDR_1965_MPIKM_mesh"
	scale = 1.0
}

entity = {
	name = "DDR_1965_MPIKM_long_idle_entity"
	pdxmesh = "DDR_1965_MPIKM_mesh"
	scale = 1.0
}
