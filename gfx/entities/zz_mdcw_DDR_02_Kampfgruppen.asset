	clone = "DDR_MD4_motorized_entity"
	name = "DDR_Mot_Militia_Bat_entity"
	attach = { name = "vehicle" vehicle = "GER_Iltis_vehicle_entity" }
	attach = { name = "infantry" infantry = "DDR_Militia_Bat_entity" }
}

