# DDR-specific versions of the existing MD vehicle + infantry composites.
# Preserve each western_european_gfx vehicle, frame, scale and state graph.
# Only the infantry attachment changes to the NVA soldier with its MPi-KM.
# The battalion sprite keys are MD4_motorized, MD4_mechanized and MD4_light_armor.

entity = {
	clone = "western_european_gfx_MD_motorized_entity"
	name = "DDR_MD4_motorized_entity"
	attach = { name = "vehicle" vehicle = "GER_Iltis_vehicle_entity" }
	attach = { name = "infantry" infantry = "DDR_MD4_infantry_2_entity" }
}

