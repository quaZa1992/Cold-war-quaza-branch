# IMPERIA COLD WAR: Place an inactive agency button over the matching native MD control.
# Two-layer input blocker technique credited to Yard1, HoI4-Intelligence-Agency-Blocker.
guiTypes = {
	containerWindowType = {
		name = "COLDWAR_SSR_agency_creation_blocker_window"
		position = { x = 0 y = 0 }
		# The lower, inert control absorbs clicks passing through the disabled upper button.
		buttonType = {
			name = "COLDWAR_SSR_agency_input_sink"
			position = { x = 25 y = 56 }
			quadTextureSprite = "GFX_create_agency_bg"
			Orientation = "LOWER_LEFT"
			pdx_tooltip = "COLDWAR_SSR_agency_blocked_tt"
		}
		buttonType = {
			name = "COLDWAR_SSR_agency_locked_button"
			position = { x = 25 y = 56 }
			quadTextureSprite = "GFX_create_agency_bg"
			buttonFont = "hoi_18mbs"
			Orientation = "LOWER_LEFT"
			buttonText = "CREATE_AGENCY_BUTTON"
			pdx_tooltip = "COLDWAR_SSR_agency_blocked_tt"
		}
	}
}
