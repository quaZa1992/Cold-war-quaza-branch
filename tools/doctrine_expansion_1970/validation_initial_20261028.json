      "passed": true,
      "detail": {
        "font": "hoi_18mbs",
        "lines": [
          "Finnish motti operations isolated road-bound columns through",
          "forest movement and flank attacks, including summer campaigns in",
          "1941 to 1944. Light infantry gains local mobility and surprise at the",
          "expense of elaborate central battle preparation."
        ],
        "height": 72,
        "limit": 80
      }
    },
    {
