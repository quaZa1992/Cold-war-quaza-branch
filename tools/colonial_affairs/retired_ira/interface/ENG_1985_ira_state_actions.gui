# IMPERIA CW — Cold War: Integrated ENG 1985 ira state actions — interface layout.
# =============================================================================
# ENG 1985 - Northern Ireland foreign-support: trigger + popup windows
# =============================================================================
# Two containerWindowTypes:
#
#   ENG_1985_ira_foreign_support_trigger_window  -> tiny single-button strip
#                                                    (the fist) on the state
#                                                    pane. Always visible to
#                                                    eligible viewers.
#
#   ENG_1985_ira_foreign_support_panel_window    -> big popup with six action
#                                                    icons + close button.
#                                                    Only renders when the
#                                                    open flag is set.
#
# Every spriteType used here is verified to exist in MD_decisions.gfx so we
# don't fall back to the placeholder cat texture.
# =============================================================================

guiTypes = {

	# -------------------------------------------------------------------------
	# Trigger window - small fist icon on the state pane
	# -------------------------------------------------------------------------
	containerWindowType = {
		name = "ENG_1985_ira_foreign_support_trigger_window"
		position = { x = 4 y = 4 }
		size = { width = 48 height = 48 }

		buttonType = {
			name = "ENG_1985_ira_open_panel"
			spriteType = "GFX_decision_fist"
			position = { x = 0 y = 0 }
			scale = 0.7
			pdx_tooltip = "ENG_1985_ira_open_panel_tt"
		}
	}

	# -------------------------------------------------------------------------
	# Panel window - the big foreign-support popup
	# -------------------------------------------------------------------------
	containerWindowType = {
		name = "ENG_1985_ira_foreign_support_panel_window"
		position = { x = 52 y = 4 }
		size = { width = 420 height = 370 }

		# Frame background
		background = {
			name = "ENG_ira_panel_bg"
			quadTextureSprite = "GFX_tiled_window"
		}

		# Close button (top-right)
		buttonType = {
			name = "ENG_1985_ira_close_panel"
			spriteType = "GFX_closebutton"
			position = { x = 390 y = 6 }
			scale = 0.9
			pdx_tooltip = "ENG_1985_ira_close_panel_tt"
		}

		# Header
		instantTextBoxType = {
			name = "ENG_ira_foreign_support_label"
			position = { x = 18 y = 14 }
			font = "hoi_20b"
			text = "ENG_ira_foreign_support_header"
			maxWidth = 360
			maxHeight = 24
			fixedsize = yes
			text_color_code = R
		}

		# Subtitle
		instantTextBoxType = {
			name = "ENG_ira_foreign_support_sub"
			position = { x = 18 y = 40 }
			font = "hoi_16mbs"
			text = "ENG_ira_foreign_support_sub"
			maxWidth = 378
			maxHeight = 44
			fixedsize = yes
			text_color_code = Y
		}

		instantTextBoxType = {
			name = "ENG_ira_foreign_support_warning"
			position = { x = 18 y = 84 }
			font = "hoi_16mbs"
			text = "ENG_ira_foreign_support_warning"
			maxWidth = 378
			maxHeight = 34
			fixedsize = yes
			text_color_code = G
		}

		# ---------- Row 1: arms / funds / propaganda ------------------------
		buttonType = {
			name = "ENG_1985_ira_send_arms_shipment"
			spriteType = "GFX_decision_arms_industry"
			position = { x = 34 y = 126 }
			scale = 0.68
			pdx_tooltip = "ENG_1985_ira_send_arms_shipment_tt"
			pdx_tooltip_delayed = "ENG_1985_ira_send_arms_shipment_cooldown_tt"
		}
